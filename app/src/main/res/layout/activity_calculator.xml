<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/calculatorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_login_gradient"
    android:padding="24dp">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/calcTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="16dp">

        <ImageButton
            android:id="@+id/calcBackButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_arrow_back_24"
            android:background="@drawable/bg_icon_circle"
            android:padding="12dp"
            app:tint="@color/md_theme_primary"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="Calculator"
            android:textColor="@color/md_theme_onSurface"
            android:textSize="22sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Calculator Display Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="@color/md_theme_surfaceContainerHigh"
        app:cardCornerRadius="28dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/md_theme_outline"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="bottom|end">

            <TextView
                android:id="@+id/tvCalcExpression"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:textSize="22sp"
                android:gravity="end"
                android:ellipsize="start"
                android:singleLine="true" />

            <TextView
                android:id="@+id/tvCalcResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="0"
                android:textColor="@color/md_theme_onSurface"
                android:textSize="40sp"
                android:textStyle="bold"
                android:gravity="end"
                android:ellipsize="start"
                android:singleLine="true" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Keypad Layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Row 1: C, DEL, %, ÷ -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:orientation="horizontal" android:layout_marginBottom="8dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCalcClear" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="C" android:textSize="20sp" android:textStyle="bold" app:cornerRadius="20dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCalcDel" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:text="⌫" android:textSize="20sp" android:textStyle="bold" app:cornerRadius="20dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCalcPercent" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:text="%" android:textSize="20sp" android:textStyle="bold" app:cornerRadius="20dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCalcDivide" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:text="÷" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/md_theme_onPrimary" app:cornerRadius="20dp" app:backgroundTint="@color/md_theme_primary" />
        </LinearLayout>

        <!-- Row 2: 7, 8, 9, × -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:orientation="horizontal" android:layout_marginBottom="8dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCalc7" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="7" android:textSize="20sp" android:textStyle="bold" app:cornerRadius="20dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCalc8" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:text="8" android:textSize="20sp" android:textStyle="bold" app:cornerRadius="20dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCalc9" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:text="9" android:textSize="20sp" android:textStyle="bold" app:cornerRadius="20dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCalcMultiply" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:text="×" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/md_theme_onPrimary" app:cornerRadius="20dp" app:backgroundTint="@color/md_theme_primary" />
        </LinearLayout>

        <!-- Row 3: 4, 5, 6, - -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:orientation="horizontal" android:layout_marginBottom="8dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCalc4" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="4" android:textSize="20sp" android:textStyle="bold" app:cornerRadius="20dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCalc5" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:text="5" android:textSize="20sp" android:textStyle="bold" app:cornerRadius="20dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCalc6" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:text="6" android:textSize="20sp" android:textStyle="bold" app:cornerRadius="20dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCalcMinus" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:text="-" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/md_theme_onPrimary" app:cornerRadius="20dp" app:backgroundTint="@color/md_theme_primary" />
        </LinearLayout>

        <!-- Row 4: 1, 2, 3, + -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:orientation="horizontal" android:layout_marginBottom="8dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCalc1" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="1" android:textSize="20sp" android:textStyle="bold" app:cornerRadius="20dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCalc2" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:text="2" android:textSize="20sp" android:textStyle="bold" app:cornerRadius="20dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCalc3" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:text="3" android:textSize="20sp" android:textStyle="bold" app:cornerRadius="20dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCalcPlus" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:text="+" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/md_theme_onPrimary" app:cornerRadius="20dp" app:backgroundTint="@color/md_theme_primary" />
        </LinearLayout>

        <!-- Row 5: 00, 0, ., = -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCalc00" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="00" android:textSize="20sp" android:textStyle="bold" app:cornerRadius="20dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCalc0" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:text="0" android:textSize="20sp" android:textStyle="bold" app:cornerRadius="20dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCalcDot" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:text="." android:textSize="20sp" android:textStyle="bold" app:cornerRadius="20dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCalcEquals" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:text="=" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/md_theme_onPrimary" app:cornerRadius="20dp" app:backgroundTint="@color/md_theme_primary" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>