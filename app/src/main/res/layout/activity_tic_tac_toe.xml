<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_login_gradient"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="24dp">

        <ImageButton
            android:id="@+id/tttBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_arrow_back_24"
            android:background="@drawable/bg_icon_circle"
            android:padding="12dp"
            app:tint="@color/md_theme_primary"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="Tic-Tac-Toe"
            android:textColor="?attr/colorOnSurface"
            android:textSize="22sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetTtt"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Reset"
            android:textAllCaps="false"
            app:cornerRadius="22dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvTttStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Player X's turn"
        android:textColor="?attr/colorPrimary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <!-- 3x3 Grid -->
    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:rowCount="3"
        android:columnCount="3"
        android:layout_gravity="center">

        <Button android:id="@+id/btn00" style="?attr/materialButtonOutlinedStyle" android:layout_width="100dp" android:layout_height="100dp" android:textSize="36sp" android:textStyle="bold" />
        <Button android:id="@+id/btn01" style="?attr/materialButtonOutlinedStyle" android:layout_width="100dp" android:layout_height="100dp" android:textSize="36sp" android:textStyle="bold" />
        <Button android:id="@+id/btn02" style="?attr/materialButtonOutlinedStyle" android:layout_width="100dp" android:layout_height="100dp" android:textSize="36sp" android:textStyle="bold" />

        <Button android:id="@+id/btn10" style="?attr/materialButtonOutlinedStyle" android:layout_width="100dp" android:layout_height="100dp" android:textSize="36sp" android:textStyle="bold" />
        <Button android:id="@+id/btn11" style="?attr/materialButtonOutlinedStyle" android:layout_width="100dp" android:layout_height="100dp" android:textSize="36sp" android:textStyle="bold" />
        <Button android:id="@+id/btn12" style="?attr/materialButtonOutlinedStyle" android:layout_width="100dp" android:layout_height="100dp" android:textSize="36sp" android:textStyle="bold" />

        <Button android:id="@+id/btn20" style="?attr/materialButtonOutlinedStyle" android:layout_width="100dp" android:layout_height="100dp" android:textSize="36sp" android:textStyle="bold" />
        <Button android:id="@+id/btn21" style="?attr/materialButtonOutlinedStyle" android:layout_width="100dp" android:layout_height="100dp" android:textSize="36sp" android:textStyle="bold" />
        <Button android:id="@+id/btn22" style="?attr/materialButtonOutlinedStyle" android:layout_width="100dp" android:layout_height="100dp" android:textSize="36sp" android:textStyle="bold" />

    </GridLayout>

</LinearLayout>