<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_login_gradient"
    android:padding="20dp">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/snakeBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_arrow_back_24"
            android:background="@drawable/bg_icon_circle"
            android:padding="12dp"
            app:tint="@color/md_theme_primary"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="Snake Game"
            android:textColor="?attr/colorOnSurface"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSnakeScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Score: 0"
            android:textColor="?attr/colorPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Game Board Container -->
    <LinearLayout
        android:id="@+id/snakeContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center" />

    <!-- Directional Control Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSnakeUp"
            android:layout_width="80dp"
            android:layout_height="50dp"
            android:text="▲"
            android:textSize="20sp"
            app:cornerRadius="16dp"
            app:backgroundTint="?attr/colorPrimary" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSnakeLeft"
                android:layout_width="80dp"
                android:layout_height="50dp"
                android:text="◀"
                android:textSize="20sp"
                app:cornerRadius="16dp"
                app:backgroundTint="?attr/colorPrimary" />

            <View
                android:layout_width="80dp"
                android:layout_height="50dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSnakeRight"
                android:layout_width="80dp"
                android:layout_height="50dp"
                android:text="▶"
                android:textSize="20sp"
                app:cornerRadius="16dp"
                app:backgroundTint="?attr/colorPrimary" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSnakeDown"
            android:layout_width="80dp"
            android:layout_height="50dp"
            android:text="▼"
            android:textSize="20sp"
            app:cornerRadius="16dp"
            app:backgroundTint="?attr/colorPrimary" />

    </LinearLayout>

</LinearLayout>